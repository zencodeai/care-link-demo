          "effect": "no delivery"
        },
        {
          "event": "proven_absent",
          "from": [
            "reconciliation_needed"
          ],
          "to": "scheduled",
          "guard": "durable inbox absent proof + previous sender/authorization fenced; valid contact consent and unexpired window",
          "effect": "same logical inbox key; fresh child authorization"
        },
        {
          "event": "absent_cancelled",
          "from": [
            "reconciliation_needed"
          ],
          "to": "cancelled",
          "guard": "durable no-send proof + previous sender fenced + optout",
          "effect": "record no delivery"
        },
        {
          "event": "absent_expired",
          "from": [
            "reconciliation_needed"
          ],
          "to": "expired",
          "guard": "durable no-send proof + previous sender fenced + window expired",
          "effect": "record no delivery"
        }
