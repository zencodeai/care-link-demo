{
  "openapi": "3.1.0",
  "info": {
    "title": "CARE-Link agentic transport amendment",
    "version": "imp06-003"
  },
  "paths": {
    "/v1/assistance/knowledge": {
      "post": {
        "operationId": "knowledge_lookup",
        "security": [
          {
            "BrowserSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 256
            }
          }
        ],
        "x-query-parameters": "forbidden",
        "x-authority": "current actor role",
        "x-effect": "read-only knowledge lookup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowledgeQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed result",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeResults"
                }
              }
            }
          },
          "400": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/broker/work": {
      "post": {
        "operationId": "runtime_work_claim",
        "security": [
          {
            "RuntimeMTLS": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-query-parameters": "forbidden",
        "x-authority": "current runtime workload",
        "x-effect": "consume ephemeral metadata only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeWorkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed result",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeWorkItem"
                }
              }
            }
          },
          "400": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Closed safe error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "KnowledgeQuery": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "locale": {
            "enum": [
              "en-CA",
              "fr-CA"
            ]
          }
        },
        "required": [
          "query",
          "locale"
        ],
        "additionalProperties": false
      },
      "KnowledgeResults": {
        "type": "object",
        "properties": {
          "catalog_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnowledgeEntry"
            },
            "maxItems": 4
          },
          "notice": {
            "const": "synthetic_demo_information"
          }
        },
        "required": [
          "catalog_digest",
          "entries",
          "notice"
        ],
        "additionalProperties": false
      },
      "KnowledgeEntry": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceRef"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "source_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "locale": {
            "enum": [
              "en-CA",
              "fr-CA"
            ]
          }
        },
        "required": [
          "source",
          "title",
          "text",
          "source_url",
          "source_title",
          "locale"
        ],
        "additionalProperties": false
      },
      "SourceRef": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "assertion",
              "plan_field",
              "directory",
              "protocol",
              "template",
              "artifact",
              "receipt",
              "health",
              "audit"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19,
            "x-decimalMaximum": "9223372036854775807",
            "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "verification": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "disputed",
              "unknown"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "revision",
          "digest",
          "observed_at",
          "verification"
        ],
        "additionalProperties": false
      },
      "RuntimeWorkRequest": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "RuntimeWorkItem": {
        "$ref": "#/components/schemas/RuntimeWork"
      },
      "RuntimeWork": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "#/components/schemas/Id"
              },
              "task_revision": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "fence": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$"
              }
            },
            "required": [
              "task_id",
              "task_revision",
              "fence"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "null"
              },
              "task_revision": {
                "type": "null"
              },
              "fence": {
                "type": "null"
              }
            },
            "required": [
              "task_id",
              "task_revision",
              "fence"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHENTICATED",
              "NOT_AUTHORIZED",
              "NOT_FOUND",
              "ASSURANCE_REQUIRED",
              "REVISION_CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "REVIEW_REQUIRED",
              "AUTHORITY_UNAVAILABLE",
              "POLICY_UNAVAILABLE",
              "AUDIT_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "RATE_LIMITED",
              "RESOURCE_BUSY",
              "CONTEXT_STALE",
              "DELIVERY_UNKNOWN",
              "COMMIT_UNKNOWN",
              "CURSOR_EXPIRED",
              "CAPABILITY_DISABLED",
              "TOKEN_EXPIRED",
              "TOKEN_USED",
              "REPLACEMENT_UNAVAILABLE",
              "DEADLINE_EXCEEDED"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "retryable": {
            "type": "boolean"
          },
          "message_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "operation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_after_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "request_id",
          "retryable",
          "message_key",
          "operation_id",
          "retry_after_ms"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "BrowserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-care_session"
      },
      "RuntimeMTLS": {
        "type": "mutualTLS",
        "description": "Exact current Runtime workload only"
      }
    }
  }
}
