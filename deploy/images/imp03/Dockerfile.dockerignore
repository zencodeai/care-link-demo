# Root build context: deny everything, then admit the actual runtime inputs.
**
!pyproject.toml
!uv.lock
!.python-version

!packages/
!packages/contracts/
!packages/contracts/python/
!packages/contracts/python/pyproject.toml
!packages/contracts/python/src/
!packages/contracts/python/src/**
!packages/domain/
!packages/domain/pyproject.toml
!packages/domain/src/
!packages/domain/src/**
!packages/policy-input/
!packages/policy-input/pyproject.toml
!packages/policy-input/src/
!packages/policy-input/src/**
!packages/workload-trust/
!packages/workload-trust/pyproject.toml
!packages/workload-trust/src/
!packages/workload-trust/src/**

!services/
!services/core/
!services/core/pyproject.toml
!services/core/src/
!services/core/src/**
!services/identity/
!services/identity/pyproject.toml
!services/identity/src/
!services/identity/src/**
!services/identity/migrations/
!services/identity/migrations/*.sql
!services/data/
!services/data/pyproject.toml
!services/data/src/
!services/data/src/**
!services/data/migrations/
!services/data/migrations/*.sql

!host/
!host/help/
!host/help/pyproject.toml
!host/help/src/
!host/help/src/**
!host/static/
!host/static/pyproject.toml
!host/static/src/
!host/static/src/**
!host/recovery-control/
!host/recovery-control/pyproject.toml
!host/recovery-control/src/
!host/recovery-control/src/**

!tools/
!tools/imp03_runtime/
!tools/imp03_runtime/*.py
!tools/imp03_shared/
!tools/imp03_shared/*.py
!tools/imp02_application/
!tools/imp02_application/__init__.py
!tools/imp02_application/browser.py
!tools/imp02_application/config.py
!tools/imp02_application/mesh.py
!tools/imp02_application/tls.py
!tools/imp02_application/provider_bootstrap.py

!config/
!config/demo/
!config/demo/imp03/
!config/demo/imp03/**
!apps/
!apps/web/
!apps/web/dist/
!apps/web/dist/**

# Do not re-admit development caches, source maps or local secret files through
# a source-directory exception above. Only generated public client assets ship.
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/node_modules
**/.DS_Store
**/.env*
**/*.key
**/*.pem
**/*.map
**/tests
**/tests/**
