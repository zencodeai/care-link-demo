{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:care-link:developer:dev-1",
  "$defs": {
    "SessionCreate": {
      "type": "object",
      "properties": {
        "tags": {
          "$ref": "#/$defs/Tag"
        },
        "participant_kind": {
          "type": "string",
          "enum": [
            "pid",
            "carer",
            "professional_participant"
          ]
        },
        "jurisdiction": {
          "$ref": "#/$defs/Jurisdiction"
        },
        "locale": {
          "$ref": "#/$defs/Locale"
        },
        "channel": {
          "type": "string",
          "enum": [
            "web",
            "sms_sim",
            "voice_sim",
            "relay_sim"
          ]
        },
        "persona_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tags",
        "participant_kind",
        "jurisdiction",
        "locale",
        "channel",
        "persona_id",
        "fixture_id"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "properties": {
        "environment": {
          "const": "demo"
        },
        "population": {
          "const": "synthetic"
        }
      },
      "required": [
        "environment",
        "population"
      ],
      "additionalProperties": false
    },
    "Jurisdiction": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "CA-XX",
            "CA-YY"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "Locale": {
      "type": "string",
      "enum": [
        "en-CA",
        "fr-CA"
      ]
    },
    "RevisionCommand": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        }
      },
      "required": [
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHENTICATED",
            "NOT_AUTHORIZED",
            "NOT_FOUND",
            "ASSURANCE_REQUIRED",
            "REVISION_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "REVIEW_REQUIRED",
            "AUTHORITY_UNAVAILABLE",
            "POLICY_UNAVAILABLE",
            "AUDIT_UNAVAILABLE",
            "DEPENDENCY_UNAVAILABLE",
            "RATE_LIMITED",
            "RESOURCE_BUSY",
            "CONTEXT_STALE",
            "DELIVERY_UNKNOWN",
            "COMMIT_UNKNOWN",
            "CURSOR_EXPIRED",
            "CAPABILITY_DISABLED",
            "TOKEN_EXPIRED",
            "TOKEN_USED",
            "REPLACEMENT_UNAVAILABLE",
            "DEADLINE_EXCEEDED"
          ]
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "retryable": {
          "type": "boolean"
        },
        "message_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "request_id",
        "retryable",
        "message_key",
        "operation_id",
        "retry_after_ms"
      ],
      "additionalProperties": false
    },
    "LoginStart": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "pid",
            "carer",
            "professional_participant",
            "worker",
            "supervisor",
            "receiver",
            "operator",
            "governance",
            "auditor",
            "security",
            "trainer"
          ]
        },
        "return_route": {
          "type": "string",
          "enum": [
            "participant",
            "workforce",
            "operations",
            "governance",
            "audit",
            "training"
          ]
        },
        "locale": {
          "$ref": "#/$defs/Locale"
        }
      },
      "required": [
        "role",
        "return_route",
        "locale"
      ],
      "additionalProperties": false
    },
    "LoginIntent": {
      "type": "object",
      "properties": {
        "intent_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "authorization_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "intent_id",
        "authorization_url",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "LoginCallback": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "format": "uri"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "additionalProperties": false
    },
    "BrowserSession": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "pid",
            "carer",
            "professional_participant",
            "worker",
            "supervisor",
            "receiver",
            "operator",
            "governance",
            "auditor",
            "security",
            "trainer"
          ]
        },
        "assurance": {
          "type": "string",
          "enum": [
            "AL0",
            "AL1",
            "AL2",
            "AL3"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "auth_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        }
      },
      "required": [
        "account_id",
        "role",
        "assurance",
        "expires_at",
        "auth_time",
        "revision"
      ],
      "additionalProperties": false
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "StepUpStart": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "plan_view",
            "plan_edit",
            "referral_consent",
            "export",
            "delete",
            "identity_link",
            "governance",
            "promotion"
          ]
        },
        "resource_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        }
      },
      "required": [
        "purpose",
        "resource_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "Ceremony": {
      "type": "object",
      "properties": {
        "ceremony_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "cooling_off",
            "confirmation_required",
            "verified",
            "expired"
          ]
        },
        "not_before": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "authorization_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ceremony_id",
        "state",
        "not_before",
        "expires_at",
        "authorization_url"
      ],
      "additionalProperties": false
    },
    "CeremonyConfirm": {
      "type": "object",
      "properties": {
        "ceremony_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "proof_intent_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        }
      },
      "required": [
        "ceremony_id",
        "proof_intent_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "HelpCreate": {
      "type": "object",
      "properties": {
        "locale": {
          "$ref": "#/$defs/Locale"
        },
        "jurisdiction": {
          "$ref": "#/$defs/Jurisdiction"
        }
      },
      "required": [
        "locale",
        "jurisdiction"
      ],
      "additionalProperties": false
    },
    "HelpView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        },
        "state": {
          "type": "string",
          "enum": [
            "recorded",
            "accepted_unconnected",
            "cancelled",
            "reconciled"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "connection_confirmed": {
          "const": false
        }
      },
      "required": [
        "id",
        "revision",
        "state",
        "created_at",
        "connection_confirmed"
      ],
      "additionalProperties": false
    },
    "HelpAuthorityRequest": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "help_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "status",
            "accept",
            "cancel",
            "reconcile"
          ]
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "browser_proof_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "nonce": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "operation_id",
        "help_id",
        "action",
        "request_digest",
        "browser_proof_ref",
        "nonce",
        "deadline"
      ],
      "additionalProperties": false
    },
    "FreshHelpAuthority": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "help_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "principal_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "status",
            "accept",
            "cancel",
            "reconcile"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "PERMIT",
            "DENY"
          ]
        },
        "identity_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        },
        "one_use_nonce": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "role_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operation_id",
        "help_id",
        "request_digest",
        "principal_id",
        "action",
        "decision",
        "identity_revision",
        "one_use_nonce",
        "issued_at",
        "expires_at",
        "signature",
        "role_revision",
        "issuer_id",
        "audience",
        "key_id"
      ],
      "additionalProperties": false
    },
    "Signal": {
      "type": "object",
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "jti": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "subject_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "credential_revoked",
            "role_changed",
            "session_revoked",
            "workload_compromised"
          ]
        },
        "source_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        },
        "previous_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "issuer_id",
        "audience",
        "jti",
        "subject_id",
        "event_type",
        "source_sequence",
        "previous_digest",
        "event_at",
        "digest",
        "signature"
      ],
      "additionalProperties": false
    },
    "SignalAck": {
      "type": "object",
      "properties": {
        "jti": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "applied",
            "duplicate",
            "gap_blocked",
            "quarantined"
          ]
        },
        "accepted_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "maxLength": 19,
          "x-decimalMaximum": "9223372036854775807",
          "description": "Canonical decimal; semantic maximum 9223372036854775807, checked by local validator."
        }
      },
      "required": [
        "jti",
        "state",
        "accepted_sequence"
      ],
      "additionalProperties": false
    },
    "StaticManifest": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locale": {
          "$ref": "#/$defs/Locale"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "review_due_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "independent_review_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "digest",
        "locale",
        "verified_at",
        "review_due_at",
        "independent_review_digest"
      ],
      "additionalProperties": false
    },
    "StaticPublish": {
      "type": "object",
      "properties": {
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_review_receipt_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_current_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_digest",
        "independent_review_receipt_id",
        "expected_current_digest"
      ],
      "additionalProperties": false
    },
    "CommandResult": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid",
