{
  "version": "care.demo.v1",
  "machines": [
    {
      "name": "session",
      "states": [
        "active",
        "human_requested",
        "queued",
        "worker_assigned",
        "handoff_pending",
        "human_controlled",
        "ended"
      ],
      "initial": "active",
      "terminal": [
        "ended"
      ],
      "transitions": [
        {
          "event": "human_request",
          "from": [
            "active"
          ],
          "to": "human_requested",
          "guard": "current participant or deterministic fixture trigger",
          "effect": "dedup ticket; preserve mandatory reason"
        },
        {
          "event": "enqueue",
          "from": [
            "human_requested"
          ],
          "to": "queued",
          "guard": "durable ticket current",
          "effect": "schedule fixture priority"
        },
        {
          "event": "accept",
          "from": [
            "queued",
            "human_requested"
          ],
          "to": "worker_assigned",
          "guard": "one current eligible reservation and revision",
          "effect": "accepted_unconnected"
        },
        {
          "event": "prepare_transfer",
          "from": [
            "worker_assigned"
          ],
          "to": "handoff_pending",
          "guard": "current assignment and context",
          "effect": "record worker ACK"
        },
        {
          "event": "confirm_transfer",
          "from": [
            "handoff_pending"
          ],
          "to": "human_controlled",
          "guard": "current worker + two-party channel evidence + epoch",
          "effect": "change owner and increment control_epoch"
        },
        {
          "event": "transfer_failed",
          "from": [
            "worker_assigned",
            "handoff_pending"
          ],
          "to": "queued",
          "guard": "current assignment",
          "effect": "release/requeue; retain support"
        },
        {
          "event": "takeover_unconnected",
          "from": [
            "active",
            "human_requested",
            "queued",
            "worker_assigned",
            "handoff_pending",
            "human_controlled"
          ],
          "to": "handoff_pending",
          "guard": "supervisor scope; no live evidence",
          "effect": "change owner; fence old epoch"
        },
        {
          "event": "takeover_connected",
          "from": [
            "active",
            "human_requested",
            "queued",
            "worker_assigned",
            "handoff_pending",
            "human_controlled"
          ],
          "to": "human_controlled",
          "guard": "supervisor scope + current live evidence",
          "effect": "change owner; fence old epoch"
        },
        {
          "event": "user_end",
          "from": [
            "active",
            "human_requested",
            "queued",
            "worker_assigned",
            "handoff_pending",
            "human_controlled"
          ],
          "to": "ended",
          "guard": "explicit authorized user choice",
          "effect": "record unresolved status; cancel optional work"
        },
        {
          "event": "human_request",
          "from": [
            "human_requested"
          ],
          "to": "human_requested",
          "guard": "current participant; existing active request/assignment",
          "effect": "idempotent current-ticket status; preserve owner/phase and original request time"
        },
        {
          "event": "human_request",
          "from": [
            "queued"
          ],
          "to": "queued",
          "guard": "current participant; existing active request/assignment",
          "effect": "idempotent current-ticket status; preserve owner/phase and original request time"
        },
        {
          "event": "human_request",
          "from": [
            "worker_assigned"
          ],
          "to": "worker_assigned",
          "guard": "current participant; existing active request/assignment",
          "effect": "idempotent current-ticket status; preserve owner/phase and original request time"
        },
        {
          "event": "human_request",
          "from": [
            "handoff_pending"
          ],
          "to": "handoff_pending",
          "guard": "current participant; existing active request/assignment",
          "effect": "idempotent current-ticket status; preserve owner/phase and original request time"
        },
        {
          "event": "human_request",
          "from": [
            "human_controlled"
          ],
          "to": "human_controlled",
          "guard": "current participant; existing active request/assignment",
          "effect": "idempotent current-ticket status; preserve owner/phase and original request time"
        }
      ],
      "unlisted_transition": "reject_without_effect",
      "guard_failure": "typed_failure_preserve_state",
      "timeout": "only_declared_timeout_event; no implicit success"
    },
    {
      "name": "transport",
      "states": [
        "connected",
        "reconnecting",
        "disconnected"
      ],
      "initial": "connected",
      "terminal": [],
      "transitions": [
        {
          "event": "lost",
          "from": [
            "connected",
            "reconnecting"
          ],
          "to": "disconnected",
          "guard": "observed transport loss",
          "effect": "preserve service phase/owner"
        },
        {
          "event": "retry",
          "from": [
            "disconnected"
          ],
          "to": "reconnecting",
          "guard": "explicit current access",
          "effect": "request current snapshot"
        },
        {
          "event": "reconnected",
          "from": [
            "reconnecting"
          ],
          "to": "connected",
          "guard": "current authority/channel proof",
          "effect": "resync permitted state"
        }
      ],
      "unlisted_transition": "reject_without_effect",
      "guard_failure": "typed_failure_preserve_state",
      "timeout": "only_declared_timeout_event; no implicit success"
    },
    {
      "name": "task",
      "states": [
        "requested",
        "scoped",
        "planning",
        "awaiting_authorization",
        "running",
        "awaiting_observation",
        "awaiting_human",
        "completed",
        "cancelled",
        "failed"
      ],
      "initial": "requested",
      "terminal": [
        "completed",
        "cancelled",
        "failed"
      ],
      "transitions": [
        {
          "event": "scope",
          "from": [
            "requested"
          ],
          "to": "scoped",
          "guard": "profile/binding/purpose/inputs admitted",
          "effect": "persist narrowed scope and budgets"
        },
        {
          "event": "plan",
          "from": [
            "scoped"
          ],
          "to": "planning",
          "guard": "current lease/fence + budget + deadline",
          "effect": "reserve proposal attempt"
        },
        {
          "event": "tool_proposed",
          "from": [
            "planning"
          ],
          "to": "awaiting_authorization",
          "guard": "closed allowed tool",
          "effect": "no tool effect"
        },
        {
          "event": "authorize",
          "from": [
            "awaiting_authorization"
          ],
          "to": "running",
          "guard": "current broker capability+PDP+budget",
          "effect": "reserve step/tool"
        },
        {
          "event": "observe_wait",
          "from": [
            "running"
          ],
          "to": "awaiting_observation",
          "guard": "invocation durable",
          "effect": "persist invocation identity"
        },
        {
          "event": "observation",
          "from": [
            "awaiting_observation"
          ],
          "to": "planning",
          "guard": "matching durable success/failure observation, completed invocation, current task/fence; no unfinished tool",
          "effect": "persist outcome before next step"
        },
        {
          "event": "review",
          "from": [
            "planning",
            "awaiting_authorization",
            "awaiting_observation"
          ],
          "to": "awaiting_human",
          "guard": "authorized review work",
          "effect": "persist draft and suspend compute"
        },
        {
          "event": "resume",
          "from": [
            "awaiting_human"
          ],
          "to": "scoped",
          "guard": "fresh actor/domain event and revised scope/deadline",
          "effect": "stale old lease/review as needed; retain counters"
        },
        {
          "event": "complete",
          "from": [
            "planning",
            "awaiting_observation",
            "awaiting_human"
          ],
          "to": "completed",
          "guard": "explicit completion predicate evidence",
          "effect": "record task outcome not client benefit"
        },
        {
          "event": "cancel",
          "from": [
            "requested",
            "scoped",
            "planning",
            "awaiting_authorization",
            "running",
            "awaiting_observation",
            "awaiting_human"
          ],
          "to": "cancelled",
          "guard": "authorized cancel/takeover/revocation",
          "effect": "increment fence; suppress late output"
        },
        {
          "event": "fail",
          "from": [
            "requested",
            "scoped",
            "planning",
            "awaiting_authorization",
            "running",
            "awaiting_observation",
            "awaiting_human"
          ],
          "to": "failed",
          "guard": "unrecoverable error/deadline/budget",
          "effect": "typed reason + manual fallback"
        }
      ],
      "unlisted_transition": "reject_without_effect",
      "guard_failure": "typed_failure_preserve_state",
      "timeout": "only_declared_timeout_event; no implicit success"
    },
    {
      "name": "dispatch",
      "states": [
        "pending",
        "authorized",
        "attempted",
        "unknown",
        "received",
        "partial",
        "accepted",
        "rejected",
        "cancelled",
        "reconciliation_needed"
      ],
      "initial": "pending",
      "terminal": [
        "accepted",
        "rejected",
        "cancelled"
      ],
      "transitions": [
        {
          "event": "authorize",
          "from": [
            "pending"
          ],
          "to": "authorized",
          "guard": "fresh rights/consent/review/source/control",
          "effect": "commit child authorization+audit"
        },
        {
          "event": "consume",
          "from": [
            "authorized"
          ],
          "to": "attempted",
          "guard": "one-use authorization CAS + current lease",
          "effect": "record send attempt before network"
        },
        {
          "event": "timeout",
          "from": [
            "attempted"
          ],
          "to": "unknown",
          "guard": "ambiguous network outcome",
          "effect": "no blind repeat"
        },
        {
          "event": "receipt",
          "from": [
            "attempted",
            "unknown",
            "reconciliation_needed"
          ],
          "to": "received",
          "guard": "verified matching receipt",
          "effect": "record receiver observation"
        },
        {
          "event": "partial",
          "from": [
            "received"
          ],
          "to": "partial",
          "guard": "receiver-owned partial decision",
          "effect": "record exact subset"
        },
        {
          "event": "accept",
          "from": [
            "received",
            "partial"
          ],
          "to": "accepted",
          "guard": "receiver-owned decision",
          "effect": "service acceptance only"
        },
        {
          "event": "reject",
          "from": [
            "received",
            "partial"
          ],
          "to": "rejected",
          "guard": "receiver-owned decision",
          "effect": "retain support/alternatives"
        },
        {
          "event": "cancel",
          "from": [
            "pending",
            "authorized"
          ],
          "to": "cancelled",
          "guard": "not consumed; current restriction",
          "effect": "fence unsent work"
        },
        {
          "event": "reconcile",
          "from": [
            "unknown",
            "partial"
          ],
          "to": "reconciliation_needed",
          "guard": "authorized query or manual recovery",
          "effect": "stable dispatch lookup; no new effect"
        },
        {
          "event": "not_found_retry",
          "from": [
            "reconciliation_needed"
          ],
          "to": "pending",
          "guard": "durable simulator dedup/not-found proof and new current authorization",
          "effect": "same dispatch ID; new child attempt"
        }
      ],
      "unlisted_transition": "reject_without_effect",
      "guard_failure": "typed_failure_preserve_state",
      "timeout": "only_declared_timeout_event; no implicit success"
    },
    {
      "name": "follow_up",
      "states": [
        "anchor_pending",
        "scheduled",
        "claimed",
        "authorized",
        "sent",
        "cancelled",
        "expired",
        "unknown",
        "reconciliation_needed"
